<!-- _includes/projects-list.liquid
  Params: items (projects). Sorted by `date` (newest first), grouped by year; month sets order within a year.
  Front matter: `categories` (list, filled chips) and `tags` (list, outlined chips); filtered independently. -->
{%- assign none = "" | split: "," -%}
{%- assign all_tags = none -%}
{%- assign all_cats = none -%}
{%- for project in include.items -%}
  {%- assign all_tags = all_tags | concat: project.tags -%}
  {%- assign all_cats = all_cats | concat: project.categories -%}
{%- endfor -%}
{%- assign all_tags = all_tags | uniq | sort -%}
{%- assign all_cats = all_cats | uniq | sort -%}
{%- assign sorted_items = include.items | sort: "date" | reverse -%}
{%- assign years = "" | split: "," -%}
{%- for project in sorted_items -%}
  {%- assign y = project.date | date: "%Y" -%}
  {%- unless years contains y -%}
    {%- assign years = years | push: y -%}
  {%- endunless -%}
{%- endfor -%}

<div class="project-filters">
  <div class="project-cats" role="group" aria-label="Filter projects by category">
    {%- for cat in all_cats -%}
      <button type="button" class="project-cat" data-cat="{{ cat }}" aria-pressed="false">{{ cat }}</button>
    {%- endfor -%}
  </div>
  <div class="project-tags" role="group" aria-label="Filter projects by tag">
    {%- for tag in all_tags -%}
      <button type="button" class="project-tag" data-tag="{{ tag }}" aria-pressed="false">{{ tag }}</button>
    {%- endfor -%}
  </div>
</div>

<div class="project-list">
  {%- for year in years -%}
    {%- assign year_items = "" | split: "," -%}
    {%- for project in sorted_items -%}
      {%- assign y = project.date | date: "%Y" -%}
      {%- if y == year -%}
        {%- assign year_items = year_items | push: project -%}
      {%- endif -%}
    {%- endfor -%}
    <section class="project-year" data-year="{{ year }}">
      {%- for project in year_items -%}
        <div class="project-row" data-cats="{{ project.categories | join: '|' }}" data-tags="{{ project.tags | join: '|' }}">
          {%- if project.img -%}
            <a class="project-thumb" href="{{ project.url | relative_url }}" tabindex="-1" aria-hidden="true">
              <img src="{{ project.img | relative_url }}" alt="" loading="lazy">
            </a>
          {%- endif -%}
          <div class="project-main">
            <div class="project-line">
              <a class="project-title" href="{{ project.url | relative_url }}">{{ project.title }}</a>
              <span class="project-year-tag">{{ year }}</span>
            </div>
            <p class="project-desc">{{ project.description }}</p>
            <div class="project-line project-line-meta">
              <div class="project-row-chips">
                {%- for cat in project.categories -%}
                  <button type="button" class="project-row-cat" data-cat="{{ cat }}">{{ cat }}</button>
                {%- endfor -%}
                {%- if project.categories.size > 0 and project.tags.size > 0 -%}
                  <span class="project-chip-sep" aria-hidden="true"></span>
                {%- endif -%}
                {%- for tag in project.tags -%}
                  <button type="button" class="project-row-tag" data-tag="{{ tag }}">{{ tag }}</button>
                {%- endfor -%}
              </div>
              <div class="project-links">
                {%- if project.github -%}
                  {%- assign repos = project.github -%}
                  {%- if repos.first == nil or repos.first.size == 1 -%}
                    {%- assign repos = repos | split: "," -%}
                  {%- endif -%}
                  {%- for repo in repos -%}
                    <a class="project-link" href="{{ repo }}" target="_blank" rel="noopener" title="GitHub: {{ repo | split: '/' | last }}" aria-label="GitHub: {{ repo | split: '/' | last }}">
                      <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"/></svg>
                    </a>
                  {%- endfor -%}
                {%- endif -%}
              </div>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </section>
  {%- endfor -%}
</div>

<script>
  (function () {
    var root = document.currentScript.parentElement;
    var rows = root.querySelectorAll(".project-row");
    var years = root.querySelectorAll(".project-year");
    var state = { cat: null, tag: null };
    var attr = { cat: "cats", tag: "tags" };

    function apply() {
      rows.forEach(function (row) {
        row.hidden = ["cat", "tag"].some(function (k) {
          return state[k] && row.dataset[attr[k]].split("|").indexOf(state[k]) === -1;
        });
      });
      years.forEach(function (year) {
        year.hidden = !year.querySelector(".project-row:not([hidden])");
      });
      ["cat", "tag"].forEach(function (k) {
        root.querySelectorAll(".project-" + k).forEach(function (chip) {
          var on = chip.dataset[k] === state[k];
          chip.classList.toggle("active", on);
          chip.setAttribute("aria-pressed", on);
        });
      });
      var parts = ["cat", "tag"]
        .filter(function (k) { return state[k]; })
        .map(function (k) { return k + "=" + encodeURIComponent(state[k]); });
      history.replaceState(null, "", parts.length ? "#" + parts.join("&") : location.pathname + location.search);
    }

    root.addEventListener("click", function (e) {
      var btn = e.target.closest("[data-cat], [data-tag]");
      if (!btn) return;
      var k = btn.dataset.cat !== undefined ? "cat" : "tag";
      state[k] = state[k] === btn.dataset[k] ? null : btn.dataset[k];
      apply();
    });

    location.hash.slice(1).split("&").forEach(function (p) {
      var kv = p.split("=");
      if (kv[0] in state && kv[1]) state[kv[0]] = decodeURIComponent(kv[1]);
    });
    if (state.cat || state.tag) apply();
  })();
</script>
